# ── Stive Timezone — environment configuration ───────────────────────────────
# Copy to .env (client) and/or provide via your deployment platform.
# NEVER commit real secrets. Values below are placeholders only.

# SERVER-SIDE SECRET (never exposed to the browser; used by the weather proxy
# in vite.config.js / the deployed API). Do NOT prefix with VITE_.
WEATHERAPI_KEY=

# PUBLIC site origin used for share links, widgets and embeds (e.g. https://timezone.stive.app)
VITE_SITE_URL=

# Base URL of the Stive Timezone API/weather proxy. Leave empty for same-origin /api.
VITE_API_BASE_URL=

# Override endpoints if hosted elsewhere (defaults shown):
# VITE_WEATHER_PROXY_URL=/api/weather/current
# VITE_METNO_URL=https://api.met.no/weatherapi/locationforecast/2.0/compact
# VITE_GOOGLE_CAL_URL=https://calendar.google.com/calendar/render
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Contact e-mail included in the MET Norway User-Agent per their terms of use.
VITE_CONTACT_EMAIL=

# Forecast days: 3 on WeatherAPI free plan, 7 on Starter (production default 7).
VITE_WEATHER_DAYS=7
